<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Плавающая карточка: отступы по бокам/сверху — чтобы скруглённые
         углы были видны на фоне приложения, а не упирались в края экрана. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_overlay_banner"
        android:padding="14dp"
        android:elevation="8dp">

        <TextView
            android:id="@+id/textReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="5"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/bannerExpand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:padding="4dp"
            android:text="@string/banner_show_full"
            android:textColor="@color/teal"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Отложить на 5 минут -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonSnooze5Mine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:minHeight="0dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:backgroundTint="@color/teal"
                android:textColor="@color/bg"
                android:textSize="11sp"
                android:text="@string/snooze_5min_mine" />

            <Button
                android:id="@+id/buttonSnooze5Everyone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minHeight="0dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:backgroundTint="@color/teal"
                android:textColor="@color/bg"
                android:textSize="11sp"
                android:text="@string/snooze_5min_everyone" />
        </LinearLayout>

        <!-- Завершить -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonDismissMine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:minHeight="0dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:backgroundTint="@color/amber"
                android:textColor="@color/bg"
                android:textStyle="bold"
                android:textSize="11sp"
                android:text="@string/dismiss_mine" />

            <Button
                android:id="@+id/buttonDismissEveryone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minHeight="0dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:backgroundTint="@color/amber"
                android:textColor="@color/bg"
                android:textStyle="bold"
                android:textSize="11sp"
                android:text="@string/dismiss_everyone" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
